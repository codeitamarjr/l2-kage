# L2 Kage settings. Copy to .env and fill in (see README-KAGE.md, "Settings"):
#   cp .env.example .env
# Generate each password with `openssl rand -hex 16`. The database passwords are baked into the database on its first
# start: change them before the first `docker compose up`, never afterwards.

# ---------------------------------------------------------------------------------------------------------------------
# Game
# ---------------------------------------------------------------------------------------------------------------------

# Address the login server sends game clients to: this machine's LAN IP for home play, or a public IP / DNS name
# (with the ports forwarded on the router) for players on the internet. Mac: 192.168.0.247. Pi: play.l2-bartz.itjunior.dev
PUBLIC_HOST=192.168.0.10
# Optional, when PUBLIC_HOST is a public address: this machine's LAN IP, handed to clients on the home network
# (LAN_SUBNET) instead, so home players don't depend on the router looping the public IP back. Pi: 192.168.0.195
# LAN_HOST=192.168.0.10
# LAN_SUBNET=192.168.0.0/16

# Ports players connect to. Keep 2106 / 7777 unless another server uses them on this host (on the Pi, Bartz does:
# Kage uses 2107 / 7778, and players set ServerPort=2107 in L2.ini).
LOGIN_PORT=2106
GAME_PORT=7777

# Logging in with a new account name creates the account.
AUTO_CREATE_ACCOUNTS=True

# Game server memory. With the full geodata (data/geodata, 224 regions) it needs 6 GB; without geodata 3 GB is enough.
GAME_JAVA_OPTS="-server -Dfile.encoding=UTF-8 -Djava.util.logging.manager=org.l2jmobius.log.ServerLogManager -Dorg.slf4j.simpleLogger.log.com.zaxxer.hikari=warn -XX:+UseZGC -Xms2g -Xmx6g"
# LOGIN_JAVA_OPTS=-Xms128m -Xmx256m

# Minutes between saves of online characters to the database; the website shows the last save (characters are
# always saved on logout). Upstream default: 15.
# CHARACTER_SAVE_MINUTES=5

# Server time zone (the website's schedules follow it). Default: UTC
# TZ=UTC

# ---------------------------------------------------------------------------------------------------------------------
# Database (MariaDB)
# ---------------------------------------------------------------------------------------------------------------------

DB_NAME=l2jmobiusessence
DB_USER=l2j
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# The website's database users, created on the first start by docker/db-init/20-web.sh:
# web reads the game database, l2web owns the website's own database.
WEB_DB_PASSWORD=change-me-web
L2WEB_DB_PASSWORD=change-me-site

# ---------------------------------------------------------------------------------------------------------------------
# Website (site/)
# ---------------------------------------------------------------------------------------------------------------------

# Shown as "L2 <SERVER_NAME>".
SERVER_NAME=Kage
# http://<PUBLIC_HOST>:<SITE_PORT> on the network.
SITE_PORT=8082
# Laravel key (keep it secret; changing it signs everyone out). Generate with:
#   docker run --rm --entrypoint php l2jmobius-site:latest artisan key:generate --show
SITE_APP_KEY=base64:generate-me

# Weekly gift box in the player area.
# GIFT_BOX_ENABLED=true

# ---------------------------------------------------------------------------------------------------------------------
# Public website (Cloudflare Tunnel) — the Pi
# ---------------------------------------------------------------------------------------------------------------------

# Cloudflare Zero Trust -> Tunnels: public hostname -> HTTP -> site:80. Uncomment all four to publish the site.
# COMPOSE_PROFILES=public
# CF_TUNNEL_TOKEN=
# WEBSITE_URL=https://l2-kage.itjunior.dev
# Trust https / client IP headers only from Docker networks (the tunnel container), never from the LAN.
# TRUSTED_PROXIES=172.16.0.0/12

# Cloudflare Turnstile bot check on registration and password resets (optional).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Email (registration and password resets). With MAIL_MAILER=log they stay closed: players create accounts in game.
# ---------------------------------------------------------------------------------------------------------------------

MAIL_MAILER=log
# Amazon SES over SMTP (the Pi): MAIL_MAILER=smtp and the SES SMTP credentials (SES -> SMTP settings).
# MAIL_HOST=email-smtp.eu-west-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@mail.itjunior.dev"
# MAIL_FROM_NAME="L2 Kage"
