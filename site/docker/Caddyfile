# FrankenPHP (Caddy) serving Laravel from /app/public. Plain http on :80 for now; for HTTPS put a domain in
# SERVER_NAME and remove "auto_https off", or keep this and run Caddy / a Cloudflare Tunnel in front.
{
	frankenphp
	auto_https off
	admin off
}

{$SERVER_NAME::80} {
	root * /app/public
	encode zstd br gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Vite output has content hashes in its names: cache forever. Media in /assets: a week.
	@hashed path /build/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /assets/*
	header @media Cache-Control "public, max-age=604800"

	request_body {
		max_size 2MB
	}

	php_server
}
